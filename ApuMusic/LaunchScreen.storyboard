<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" launchScreen="YES" initialViewController="apu-launch">
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23094"/>
    </dependencies>
    <scenes>
        <scene sceneID="apu-launch-scene">
            <objects>
                <viewController id="apu-launch" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="apu-launch-view">
                        <rect key="frame" x="0.0" y="0.0" width="390" height="844"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="ApuMascot" translatesAutoresizingMaskIntoConstraints="NO" id="apu-launch-logo">
                                <rect key="frame" x="131" y="358" width="128" height="128"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="128" id="apu-logo-width"/>
                                    <constraint firstAttribute="height" constant="128" id="apu-logo-height"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                        <constraints>
                            <constraint firstItem="apu-launch-logo" firstAttribute="centerX" secondItem="apu-launch-view" secondAttribute="centerX" id="apu-logo-x"/>
                            <constraint firstItem="apu-launch-logo" firstAttribute="centerY" secondItem="apu-launch-view" secondAttribute="centerY" id="apu-logo-y"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="apu-launch-responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="ApuMascot" width="384" height="384"/>
    </resources>
</document>
